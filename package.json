{
  "name": "game-3d",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:portal": "tsc --noEmit && vite build --mode portal --outDir dist-portal",
    "build:desktop": "tsc --noEmit && vite build --mode desktop --outDir desktop/game --emptyOutDir && npm --prefix desktop run package",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"shared/**/*.test.ts\" \"server/**/*.test.ts\" \"src/**/*.test.ts\"",
    "server": "node server/main.ts",
    "server:dev": "node --watch server/main.ts --dev",
    "start": "npm run build && node server/main.ts",
    "share": "npm run build && node scripts/share.ts"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
